# ==========================================
# Cloudflare R2 Storage Configuration
# ==========================================
R2_ACCOUNT_ID=your_cloudflare_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET=your_r2_bucket_name_here
R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev

# ==========================================
# Cloudflare D1 Database Configuration (Optional for REST API / Dev)
# ==========================================
# For Cloudflare Pages/Workers, binding 'DB' is configured in wrangler.json.
# For REST API queries or local dev fallback:
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ==========================================
# Supabase Configuration
# ==========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
